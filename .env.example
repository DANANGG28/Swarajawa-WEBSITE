APP_NAME="Sinau Jowo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"

# --- Resend (email transaksional: tautan reset kata sandi) ---
# Isi RESEND_API_KEY, lalu ubah MAIL_MAILER menjadi "resend" untuk mengaktifkan.
RESEND_API_KEY=

# --- Google OAuth (tombol "Masuk dengan Google") ---
# Isi kredensial dari Google Cloud Console. Redirect URI:
#   {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Sinau Jowo AI Speech (setup-tts-stt-live.md) ---
# STT: ElevenLabs Scribe — kosong = mode mock deterministik (PRD §9).
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_STT_LANGUAGE=jav
# TTS: edge-tts — dipanggil via exec(), tidak butuh API key.
EDGE_TTS_BINARY=edge-tts
EDGE_TTS_VOICE=jv-ID-DimasNeural
EDGE_TTS_VOICE_DIMAS=jv-ID-DimasNeural
EDGE_TTS_VOICE_SITI=jv-ID-SitiNeural
EDGE_TTS_VOICE_FEEDBACK=id-ID-ArdiNeural
# Gemini Live Translation (opsional, FR-8 Opsi B).
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview

# --- RAG Chatbot LLM Provider (OpenAI-compatible; kosong = fallback keyword retrieval) ---
# Jangan commit nilai asli. Isi hanya di .env masing-masing environment.
# Catatan Sail/Docker: proxy di host tidak bisa diakses via "localhost" dari dalam
# container — gunakan http://host.docker.internal:20128/v1.
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=ag/gemini-3.8-flash
AI_PROVIDER_TIMEOUT=30

WWWUSER=1000
WWWGROUP=1000
APP_PORT=8000
VITE_PORT=5173
FORWARD_DB_PORT=5432
# SAIL_XDEBUG_MODE=off
# SAIL_XDEBUG_CONFIG=client_host=host.docker.internal
